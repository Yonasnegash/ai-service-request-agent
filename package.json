{
    "name": "ai-service-request-agent",
    "version": "1.0.0",
    "description": "An AI-assisted service request processing system that classifies incoming email requests, applies deterministic routing policies, and supports auditable, recoverable human-in-the-loop workflows.",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "lint": "eslint ."
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Yonasnegash/ai-service-request-agent.git"
    },
    "keywords": [],
    "author": "",
    "license": "UNLICENSED",
    "bugs": {
        "url": "https://github.com/Yonasnegash/ai-service-request-agent/issues"
    },
    "homepage": "https://github.com/Yonasnegash/ai-service-request-agent#readme",
    "private": true,
    "engines": {
        "node": ">=22 <23"
    },
    "dependencies": {
        "express": "^5.3.0",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    }
}
